# Telegram API Credentials (Get them from https://my.telegram.org)
API_ID=12345
API_HASH=your_api_hash_here

# Session Persistence
# Pro-tip: Use an absolute path for SESSION_NAME to ensure compatibility with Codex and different working directories.
SESSION_NAME=telegram_mcp_session

# Optional: Phone number for faster authentication
# TELEGRAM_PHONE_NUMBER=+1234567890

# Server Settings
SERVER_NAME=Telegram MCP Server
LOG_LEVEL=INFO
DEBUG=False

# Download & Upload Settings
# Pro-tip: Use absolute paths for these directories.
TELEGRAM_DOWNLOAD_DIR=storage/downloads/telegram
TELEGRAM_UPLOAD_DIR=storage/uploads/telegram
TELEGRAM_DOWNLOAD_MAX_FILE_SIZE_MB=100
TELEGRAM_UPLOAD_MAX_FILE_SIZE_MB=100
